rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSpaceMember(spaceId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/privateSpaces/$(spaceId)).data.members;
    }

    function validPairingCode(pairingCode) {
      return pairingCode.matches('MINE-[A-Z0-9]{8}');
    }

    match /users/{userId} {
      allow read: if isSignedIn() && userId == request.auth.uid;
      allow create: if isSignedIn()
        && userId == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
        && userId == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /pairingCodes/{pairingCode} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && validPairingCode(pairingCode)
        && request.resource.data.keys().hasOnly(['spaceId'])
        && request.resource.data.spaceId is string
        && getAfter(/databases/$(database)/documents/privateSpaces/$(request.resource.data.spaceId)).data.pairingCode == pairingCode
        && getAfter(/databases/$(database)/documents/privateSpaces/$(request.resource.data.spaceId)).data.createdBy == request.auth.uid;
      allow delete: if isSignedIn()
        && exists(/databases/$(database)/documents/privateSpaces/$(resource.data.spaceId))
        && get(/databases/$(database)/documents/privateSpaces/$(resource.data.spaceId)).data.pairingCode == pairingCode
        && get(/databases/$(database)/documents/privateSpaces/$(resource.data.spaceId)).data.members.size() == 1
        && request.auth.uid in get(/databases/$(database)/documents/privateSpaces/$(resource.data.spaceId)).data.members
        && !existsAfter(/databases/$(database)/documents/privateSpaces/$(resource.data.spaceId));
      allow update: if false;
    }

    match /privateSpaces/{spaceId} {
      allow get: if isSignedIn() && request.auth.uid in resource.data.members;
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['id', 'pairingCode', 'members', 'createdBy', 'status', 'createdAt'])
        && request.resource.data.id == spaceId
        && validPairingCode(request.resource.data.pairingCode)
        && request.resource.data.members is list
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'waiting'
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/pairingCodes/$(request.resource.data.pairingCode)).data.spaceId == spaceId;
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'status'])
        && (
          (
            resource.data.status == 'waiting'
            && resource.data.members is list
            && resource.data.members.size() == 1
            && !(request.auth.uid in resource.data.members)
            && request.resource.data.members is list
            && request.resource.data.members.size() == 2
            && request.resource.data.members.hasAll(resource.data.members)
            && request.auth.uid in request.resource.data.members
            && request.resource.data.status == 'paired'
            && exists(/databases/$(database)/documents/pairingCodes/$(resource.data.pairingCode))
            && get(/databases/$(database)/documents/pairingCodes/$(resource.data.pairingCode)).data.spaceId == spaceId
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.spaceId == null
            && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.spaceId == spaceId
          )
          ||
          (
            request.auth.uid in resource.data.members
            && resource.data.members.size() == 2
            && request.resource.data.members is list
            && request.resource.data.members.size() == 1
            && resource.data.members.hasAll(request.resource.data.members)
            && !(request.auth.uid in request.resource.data.members)
            && request.resource.data.status == 'waiting'
            && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.spaceId == null
          )
        );
      allow delete: if isSignedIn()
        && request.auth.uid in resource.data.members
        && resource.data.members.size() == 1
        && !existsAfter(/databases/$(database)/documents/pairingCodes/$(resource.data.pairingCode));
    }

    match /privateSpaces/{spaceId}/messages/{messageId} {
      allow read: if isSpaceMember(spaceId);
      allow create: if isSpaceMember(spaceId)
        && request.resource.data.keys().hasOnly([
          'text', 'senderId', 'senderName', 'createdAt', 'status', 'type', 'readBy', 'editedAt', 'replyTo'
        ])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderName is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'sent'
        && request.resource.data.type == 'text'
        && request.resource.data.readBy == [request.auth.uid]
        && request.resource.data.editedAt == null
        && request.resource.data.replyTo == null;
      allow update: if isSpaceMember(spaceId)
        && (
          (
            resource.data.senderId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 4000
            && request.resource.data.editedAt == request.time
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
            && request.resource.data.readBy is list
            && request.resource.data.readBy.size() <= 2
            && request.resource.data.readBy.hasAll(resource.data.readBy)
            && request.auth.uid in request.resource.data.readBy
          )
        );
      allow delete: if isSpaceMember(spaceId)
        && resource.data.senderId == request.auth.uid;
    }
  }
}
